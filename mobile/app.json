{
  "expo": {
    "name": "Toci",
    "slug": "toci-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "toci",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toci.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Toci uses your camera to scan food barcodes and capture progress photos.",
        "NSPhotoLibraryUsageDescription": "Toci uses your photo library to attach progress photos and upload custom food images.",
        "NSPhotoLibraryAddUsageDescription": "Toci saves progress photos you capture to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF0E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.toci.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 380
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
